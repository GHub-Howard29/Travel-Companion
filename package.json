{
  "name": "travel-companion",
  "private": true,
  "version": "3.6.4",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:release-history && npm run verify:update-policy && npm run verify:itinerary-time && npm run verify:itinerary-travel && npm run verify:travel-route && npm run verify:v362-trip-lock && npm run verify:v363-front-end && npm run verify:v364-trip-data-revision && npm run verify:v364-release && tsc && vite build",
    "postbuild": "npm run verify:browser-security",
    "verify:browser-security": "node scripts/verify-browser-security.mjs",
    "verify:itinerary-time": "node --experimental-strip-types --no-warnings scripts/verify-itinerary-time.mjs",
    "verify:itinerary-travel": "node --experimental-strip-types --no-warnings scripts/verify-itinerary-travel.mjs",
    "verify:travel-route": "node --experimental-strip-types --no-warnings scripts/verify-travel-route.mjs",
    "verify:v362-trip-lock": "node --experimental-strip-types --no-warnings scripts/verify-v362-trip-lock.mjs",
    "verify:v363-front-end": "node --experimental-strip-types --no-warnings scripts/verify-v363-front-end.mjs",
    "verify:v364-trip-data-revision": "node --experimental-strip-types --no-warnings scripts/verify-v364-trip-data-revision.mjs",
    "verify:v364-release": "node --check scripts/prepare-v364-release.mjs && node scripts/verify-v364-release-preparation.mjs",
    "verify:update-policy": "node --experimental-strip-types --no-warnings scripts/verify-update-policy.mjs",
    "verify:release-history": "node scripts/verify-release-history.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "release:v364:prepare-assets": "npm run build && node scripts/prepare-v364-release.mjs prepare-assets",
    "release:v364:publish-assets": "node scripts/prepare-v364-release.mjs assert-assets-ready && gh-pages -d .release/v364-assets --add -m \"Deploy V3.6.4 assets with V3.6.3 metadata\"",
    "release:v364:verify-assets": "node scripts/prepare-v364-release.mjs verify-assets",
    "release:v364:publish-metadata": "node scripts/prepare-v364-release.mjs assert-metadata-ready && gh-pages -d dist --add -m \"Publish V3.6.4 mandatory update metadata\"",
    "release:v364:verify-metadata": "node scripts/prepare-v364-release.mjs verify-metadata",
    "release:v364:cleanup": "node scripts/prepare-v364-release.mjs cleanup"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.108.2",
    "exceljs": "^4.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "lucide-react": "^1.21.0",
    "supabase": "2.115.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
