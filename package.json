{
  "name": "travel-companion",
  "private": true,
  "version": "3.9.0",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "setup": "npm ci",
    "dev": "vite",
    "build": "npm run verify:release-history && npm run verify:update-policy && npm run verify:itinerary-time && npm run verify:itinerary-travel && npm run verify:itinerary-day-style && npm run verify:itinerary-order && npm run verify:trip-lifecycle && npm run verify:v370-time-adjustment && npm run verify:travel-route && npm run verify:v390-place-photos && npm run verify:v391-cover-photo && npm run verify:v391-commons-precision && npm run verify:v391-wikimedia-parsers && npm run verify:v391-precision-pipeline && npm run verify:v391-precision-session && npm run verify:v391-precision-transport && npm run verify:v391-precision-response && npm run verify:v391-precision-quota && npm run verify:v391-precision-cache && npm run verify:v391-precision-usage && npm run verify:v391-precision-usage-daily && npm run verify:v391-precision-usage-persistence && npm run verify:v391-precision-engine && npm run verify:v391-precision-fetch && npm run verify:v391-precision-database && npm run verify:v391-precision-integration && npm run verify:v362-trip-lock && npm run verify:v363-front-end && npm run verify:v364-trip-data-revision && npm run verify:v364-release && npm run verify:v365-performance && tsc && vite build",
    "postbuild": "npm run verify:browser-security",
    "verify:browser-security": "node scripts/verify-browser-security.mjs",
    "verify:itinerary-time": "node --experimental-strip-types --no-warnings scripts/verify-itinerary-time.mjs",
    "verify:itinerary-travel": "node --experimental-strip-types --no-warnings scripts/verify-itinerary-travel.mjs",
    "verify:itinerary-day-style": "node --experimental-strip-types --no-warnings scripts/verify-itinerary-day-style.mjs",
    "verify:itinerary-order": "node --experimental-strip-types --no-warnings scripts/verify-itinerary-order.mjs",
    "verify:trip-lifecycle": "node --experimental-strip-types --no-warnings scripts/verify-trip-lifecycle.mjs",
    "verify:v370-time-adjustment": "node --experimental-strip-types --no-warnings scripts/verify-v370-time-adjustment.mjs",
    "verify:travel-route": "node --experimental-strip-types --no-warnings scripts/verify-travel-route.mjs",
    "verify:v390-place-photos": "node --experimental-strip-types --no-warnings scripts/verify-v390-place-photos.mjs",
    "verify:v391-cover-photo": "node --experimental-strip-types --no-warnings scripts/verify-v391-cover-photo.mjs",
    "verify:v391-commons-precision": "node --experimental-strip-types --no-warnings scripts/verify-v391-commons-precision.mjs",
    "verify:v391-wikimedia-parsers": "node --experimental-strip-types --no-warnings scripts/verify-v391-wikimedia-parsers.mjs",
    "verify:v391-precision-pipeline": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-pipeline.mjs",
    "verify:v391-precision-session": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-session.mjs",
    "verify:v391-precision-transport": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-transport.mjs",
    "verify:v391-precision-response": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-response.mjs",
    "verify:v391-precision-quota": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-quota.mjs",
    "verify:v391-precision-cache": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-cache.mjs",
    "verify:v391-precision-usage": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-usage.mjs",
    "verify:v391-precision-usage-daily": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-usage-daily.mjs",
    "verify:v391-precision-usage-persistence": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-usage-persistence.mjs",
    "verify:v391-precision-engine": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-engine.mjs",
    "verify:v391-precision-fetch": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-fetch.mjs",
    "verify:v391-precision-database": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-database.mjs",
    "verify:v391-precision-integration": "node --experimental-strip-types --no-warnings scripts/verify-v391-precision-integration.mjs",
    "verify:v362-trip-lock": "node --experimental-strip-types --no-warnings scripts/verify-v362-trip-lock.mjs",
    "verify:v363-front-end": "node --experimental-strip-types --no-warnings scripts/verify-v363-front-end.mjs",
    "verify:v364-trip-data-revision": "node --experimental-strip-types --no-warnings scripts/verify-v364-trip-data-revision.mjs",
    "verify:v364-release": "node --check scripts/prepare-v364-release.mjs && node scripts/verify-v364-release-preparation.mjs",
    "verify:v365-performance": "node --experimental-strip-types --no-warnings scripts/verify-v365-performance.mjs",
    "verify:update-policy": "node --experimental-strip-types --no-warnings scripts/verify-update-policy.mjs",
    "verify:release-history": "node scripts/verify-release-history.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "release:v364:prepare-assets": "npm run build && node scripts/prepare-v364-release.mjs prepare-assets",
    "release:v364:publish-assets": "node scripts/prepare-v364-release.mjs assert-assets-ready && gh-pages -d .release/v364-assets --add -m \"Deploy V3.6.4 assets with V3.6.3 metadata\"",
    "release:v364:verify-assets": "node scripts/prepare-v364-release.mjs verify-assets",
    "release:v364:publish-metadata": "node scripts/prepare-v364-release.mjs assert-metadata-ready && gh-pages -d dist --add -m \"Publish V3.6.4 mandatory update metadata\"",
    "release:v364:verify-metadata": "node scripts/prepare-v364-release.mjs verify-metadata",
    "release:v364:cleanup": "node scripts/prepare-v364-release.mjs cleanup"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.108.2",
    "exceljs": "^4.4.0",
    "lunar-javascript": "^1.7.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "lucide-react": "^1.21.0",
    "supabase": "2.115.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
