{
  "trips": [
    {
      "id": "group-tour-2026-10",
      "title": "英鈦日本九州極上五日",
      "departure_date": "2026-10-03",
      "currency_config": {
        "code": "JPY",
        "symbol": "￥"
      },
      "sidebar_config": [
        {
          "id": "itinerary",
          "title": "團體每日行程",
          "type": "itinerary"
        },
        {
          "id": "checklist",
          "title": "共同檢查清單",
          "type": "checklist"
        },
        {
          "id": "leader_info",
          "title": "領隊導遊聯絡資訊",
          "type": "text"
        },
        {
          "id": "other_info",
          "title": "其他資訊",
          "type": "otherInfo"
        },
        {
          "id": "expense",
          "title": "旅費記帳本",
          "type": "expense"
        }
      ],
      "content": {
        "custom_tab_1": {
          "mainText": "去程航班：星宇航空 JX846 | 桃園機場 07:30 ➡️ 熊本機場 10:45\n回程航班：星宇航空 JX841 | 福岡機場 14:15 ➡️ 桃園機場 15:45\n團體叮嚀：請於出發當天 05:30 前抵達桃園機場指定櫃檯找領隊集合辦理登機。",
          "subtitle": "星宇航空豪華客機・北九州秋楓出遊"
        },
        "days": [
          1,
          2,
          3,
          4,
          5
        ],
        "daysData": {
          "1": [
            {
              "desc": "於指定櫃檯集合，辦理團體登機與行李託運。搭乘星宇航空 JX846（07:30 起飛）。",
              "location": "桃園國際機場",
              "time": "05:30",
              "title": "桃園國際機場集合",
              "type": "交通",
              "typeColor": "bg-emerald-50 text-emerald-700 border-emerald-200"
            },
            {
              "desc": "專車迎賓出發，前往參觀名列日本三大名城之一的「熊本城」，特別登臨氣勢磅礡的黑色天守閣。",
              "location": "熊本城",
              "time": "10:45",
              "title": "抵達熊本空港 ➡️ 前往熊本城",
              "type": "交通",
              "typeColor": "bg-emerald-50 text-emerald-700 border-emerald-200"
            },
            {
              "desc": "漫步在重現江戶時代城下町風貌的復古老街，可自行品嚐各式熊本在地傳統點心與美食。",
              "location": "櫻之馬場‧城彩苑",
              "time": "13:30",
              "title": "櫻之馬場‧城彩苑",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "搭乘極具人氣、車廂外觀彩繪著滿滿萌樣營業部長的「熊本熊地方路面電車」。",
              "location": "熊本熊電鐵",
              "time": "15:00",
              "title": "特別安排 ★ 熊本熊電鐵體驗",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "入住市區飯店後，可自由漫步全九州最大的拱廊商店街「下通、上通」，自由逛街購物與享用道地晚餐。",
              "location": "熊本上、下通商店街",
              "time": "18:00",
              "title": "夜訪熊本上下通商店街 & 飯店",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            }
          ],
          "2": [
            {
              "desc": "漫步在神話之鄉的自然芬多精步道，欣賞由阿蘇火山噴發冷卻形成的壯麗柱狀節理斷崖。",
              "location": "高千穗峽",
              "time": "09:30",
              "title": "峽谷秘境～高千穗峽散策",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "親眼見證從高達 17 公尺的高處傾瀉而下的絕美飛瀑，也是高千穗峽最經典的地標景致。",
              "location": "真名井瀑布",
              "time": "11:00",
              "title": "日本瀑布百選～真名井瀑布",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "參拜充滿日本神話色彩的神社，遠眺天照大神曾經隱居的神祕洞窟（天岩戶）。",
              "location": "天岩戶神社",
              "time": "13:30",
              "title": "天岩戶神社參拜",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "拾級而上穿過宛如動漫、電影場景般的深綠色青苔石燈籠參道，走入隱密夢幻的神聖結界空間。",
              "location": "上色見熊野座神社",
              "time": "15:30",
              "title": "夢幻異世界～上色見熊野座神社",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "入住大自然懷抱中的溫泉旅館，享用精緻會席料理，並體驗舒適溫泉徹底放鬆身心。",
              "location": "阿蘇溫泉旅館",
              "time": "18:00",
              "title": "抵達阿蘇溫泉區飯店",
              "type": "住宿",
              "typeColor": "bg-amber-50 text-amber-700 border-amber-200"
            }
          ],
          "3": [
            {
              "desc": "搭乘特製專屬的獅子、大象造型叢林巴士出發，在開放園區內近距離親手餵食猛獸與草食動物！",
              "location": "九州自然動物園 African Safari",
              "time": "09:30",
              "title": "九州自然動物園～叢林巴士探險",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "漫步於如夢似幻、半溫泉半冷水交互湧出的金鱗湖畔；隨後前往充滿歐風童話與文青小店的湯之坪街道自由探索。",
              "location": "由布院",
              "time": "13:00",
              "title": "由布院金鱗湖 ＆ 湯之坪街道散策",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "參觀著名的別府地獄溫泉。海地獄因富含硫酸鐵，呈現如Tiffany藍一般的神祕澄澈蔚藍色，卻是高達 98 度的滾燙溫泉。",
              "location": "別府海地獄",
              "time": "16:00",
              "title": "別府海地獄巡禮",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "入住全日本湧泉量第一的別府溫泉區，享用在地豐盛料理，今晚繼續享受極上湯泉溫養。",
              "location": "別府溫泉飯店",
              "time": "18:00",
              "title": "入住別府溫泉飯店",
              "type": "住宿",
              "typeColor": "bg-amber-50 text-amber-700 border-amber-200"
            }
          ],
          "4": [
            {
              "desc": "特別安排工廠導覽，深入瞭解知名日系啤酒的釀造與包裝製程，結束後提供新鮮出廠的美味啤酒試飲體驗。",
              "location": "SAPPORO 啤酒日田工廠",
              "time": "09:30",
              "title": "SAPPORO 啤酒九州日田工廠見學",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "前往供奉日本學問之神菅原道真的總本宮參拜，祈求考運與順利。推薦在表參道購買現烤的「梅枝餅」品嚐。",
              "location": "太宰府天滿宮",
              "time": "12:30",
              "title": "太宰府天滿宮參拜",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "停留約一小時。這裡提供豐富的日系健康保健品、美妝護膚及在地特色名產伴手禮，可輕鬆一次購足。",
              "location": "福岡市內免稅店",
              "time": "15:00",
              "title": "免稅店採購時間",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            },
            {
              "desc": "入住福岡市區飯店。傍晚可自行前往福岡最繁華的天神商圈購物，或沿著那珂川散步至「中洲屋台街」品嚐經典的博多豚骨拉麵宵夜。",
              "location": "天神 / 中洲屋台",
              "time": "17:00",
              "title": "夜訪天神中洲不夜城 ＆ 飯店入住",
              "type": "景點",
              "typeColor": "bg-purple-50 text-purple-700 border-purple-200"
            }
          ],
          "5": [
            {
              "desc": "專車前往福岡國際機場，由領隊協助團體辦理劃位登機及行李託運手續，免稅店進行最後採買。",
              "location": "福岡空港",
              "time": "11:30",
              "title": "抵達福岡空港",
              "type": "交通",
              "typeColor": "bg-emerald-50 text-emerald-700 border-emerald-200"
            },
            {
              "desc": "搭乘星宇航空豪華客機 JX841，預計於台灣時間 15:45 抵達桃園機場，圓滿結束精彩的北九州極上五日遊！",
              "location": "桃園國際機場",
              "time": "14:15",
              "title": "搭機返台 ➡️ 抵達桃園國際機場",
              "type": "交通",
              "typeColor": "bg-emerald-50 text-emerald-700 border-emerald-200"
            }
          ]
        }
      },
      "created_at": "2026-10-22T08:04:37.747562+00:00",
      "updated_at": "2026-11-11T12:50:17.732256+00:00",
      "is_public": false
    },
